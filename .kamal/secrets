# Kamal secrets — these are resolved from the environment at runtime.
# DO NOT commit real values here; this file is safe for git.
#
# CI provides them via GitHub Actions secrets (see .github/workflows/deploy.yml);
# local deploys must export them in your shell.
#
# Reference: https://kamal-deploy.org/docs/configuration/environment-variables/

# Docker Hub Personal Access Token — authenticates registry push/pull.
# Referenced by: registry.password in config/deploy.yml
DOCKER_PA_TOKEN=$DOCKER_PA_TOKEN

# Vaultwarden admin panel token.
# Referenced by: env.secret in config/deploy.yml
ADMIN_TOKEN=$ADMIN_TOKEN